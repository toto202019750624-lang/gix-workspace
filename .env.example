# ローカルは docker compose の Postgres。本番は Neon / Supabase / Vercel Postgres の接続文字列。
DATABASE_URL="postgresql://gix:gix@localhost:5432/gix"
# マイグレーション用。プールしない直接接続。ローカルでは DATABASE_URL と同じでよい。
DIRECT_URL="postgresql://gix:gix@localhost:5432/gix"

# 本番では必ず長いランダム文字列に変更する。
AUTH_SECRET="please-change-this-secret"

# local | s3 | blob 。未指定なら Blob トークン、次に S3、なければ local。
STORAGE_DRIVER="local"
UPLOAD_DIR="./data/uploads"

# auto は Vercel 上で poll、それ以外は sse。poll / sse で固定もできる。
REALTIME_MODE="auto"

# 実AI。どれか1つ。未設定なら定型応答。
# AI_API_KEY=""
# OPENAI_API_KEY=""
# XAI_API_KEY=""
# AI_BASE_URL="https://api.openai.com/v1"
# AI_MODEL="gpt-4o-mini"
# xAI の例: AI_BASE_URL="https://api.x.ai/v1"  AI_MODEL="grok-3"

# Vercel Blob（STORAGE_DRIVER=blob）
# BLOB_READ_WRITE_TOKEN=""

# S3 互換（STORAGE_DRIVER=s3）。R2 なら S3_ENDPOINT を指定。
# S3_ENDPOINT=""
# S3_BUCKET=""
# S3_REGION="auto"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# 本番で共有データを消すときだけ true。通常は空のまま。
# ALLOW_SEED_RESET=""

# 外部エージェント（Grok Bot）が AI社員として投稿するための秘密。必ず長いランダム文字列。
# AGENT_API_TOKEN=""

# Vercel Cron が朝の出勤 tick を呼ぶとき使う秘密。Hobby は1日1回。
# CRON_SECRET=""

# 画面を開いたときの自動 tick の最短間隔（分）。既定 20。
# AI_TICK_MINUTES="20"
# 1回の tick で出勤・退勤する人数。既定 8。
# AI_TICK_EMPLOYEES="8"

PORT=3000
