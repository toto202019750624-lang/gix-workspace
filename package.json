{
  "name": "gix-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "株式会社GIX の社内グループウェア GIX Workspace",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "prisma generate && next build",
    "start": "tsx scripts/start.ts",
    "test": "vitest run",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "tsx prisma/seed.ts --reset",
    "db:use-postgres": "node scripts/use-postgres.mjs",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "next": "^15.5.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prisma": "^6.19.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
